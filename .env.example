# Copy to .env. Every value is optional: with nothing set the service runs on BM25 and the mock model.

BUSINESS_NAME="Maple Grove Dental"
BUSINESS_PHONE="(416) 555-0142"

KB_DIR=data/kb
INDEX_DIR=data/index
DB_PATH=data/handoffs.db

# LLM: auto = Anthropic if a key is set, else OpenAI if a key is set, else the mock.
LLM_PROVIDER=auto            # auto | anthropic | openai | mock
LLM_BASE_URL=                # blank = provider default; set for any OpenAI-compatible server
LLM_MODEL=                   # blank = claude-haiku-4-5 (anthropic) or gpt-4o-mini (openai)
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional embeddings, fused with BM25 by reciprocal rank. Off by default.
EMBEDDINGS_PROVIDER=none     # none | openai | voyage
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=

# Answer behaviour
TOP_K=4
SCOPE_FLOOR=0.2              # below this a question is treated as off-topic
CONFIDENCE_THRESHOLD=0.45    # below this the answer is handed to a person
HISTORY_TURNS=4
SESSION_TTL_SECONDS=1800
MAX_MESSAGE_CHARS=1000

# Rate limits (requests per minute)
RATE_LIMIT_SESSION_PER_MINUTE=12
RATE_LIMIT_IP_PER_MINUTE=40
TRUST_PROXY=false            # true only behind a proxy that sets X-Forwarded-For

# Human handoff
HANDOFF_WEBHOOK_URL=         # Slack incoming webhook, or the n8n workflow URL
HANDOFF_WEBHOOK_FORMAT=json  # json (Slack payload plus extra fields) | slack (text and blocks only)
HANDOFF_COOLDOWN_SECONDS=1800

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_BASE_URL=https://graph.facebook.com/v21.0

# POST /ingest is disabled until this is set
ADMIN_TOKEN=
CORS_ORIGINS=*               # comma separated list of site origins in production
